{
    "tasks": {
        "dev": "deno run -A --watch src/main.ts",
        "compile": "deno compile -A --include public --icon public/icon.ico -o \"vscode-pretty-styles/VS Code Pretty Styles\" src/main.ts"
    },
    "imports": {
        "@std/fs": "jsr:@std/fs@1.0.22",
        "@std/http": "jsr:@std/http@1.0.24",
        "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
        "@std/media-types": "jsr:@std/media-types@1.1.0",
        "@std/net": "jsr:@std/net@1.0.6",
        "@std/path": "jsr:@std/path@1.1.4",
        "@valibot/valibot": "jsr:@valibot/valibot@1.2.0",
        "preact": "npm:preact@10.28.3",
        "preact-render-to-string": "npm:preact-render-to-string@6.6.5"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "preact"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "exclude": ["**/pico*.css"]
    }
}
